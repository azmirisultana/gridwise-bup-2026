# Environment Configuration Template for GridWise Backend
# Copy this file to .env and set your Gemini API key

# Google Gemini API Key (Required for LLM interpretation)
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier (Default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Service Port and Host
PORT=8000
HOST=0.0.0.0
